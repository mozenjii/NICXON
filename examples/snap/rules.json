  "ambiguities": [
    {
      "id": "ambiguity.snap.gross_income_exclusions",
      "type": "scope",
      "blocking": false,
      "affects": [
        "rule.snap.gross_monthly_income"
      ],
      "question": "Does gross monthly income mean income before or after the exclusions listed at 273.9(c)?",
      "interpretations": [
        {
          "id": "before_exclusions",
          "description": "Sum all income, then subtract (c) exclusions as a separate step."
        },
        {
          "id": "after_exclusions",
          "description": "Member-level income inputs are already net of (c) exclusions."
        }
      ],
      "resolution": {
        "chosen": "after_exclusions",
        "by": "fixture-author",
        "rationale": "The regulation reads 'all income from whatever source excluding only items specified in paragraph (c)', which defines income as already net of exclusions. Recorded so a reviewer can overturn it."
      },
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(b)"
        }
      ]
    }
  ]
}
