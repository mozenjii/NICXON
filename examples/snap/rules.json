  "rules": [
    {
      "id": "rule.snap.member_is_elderly_or_disabled",
      "kind": "classification",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.member.is_elderly_or_disabled",
          "value": {
            "op": "any",
            "args": [
              {
                "op": "gte",
                "left": {
                  "op": "ref",
                  "id": "var.member.age"
                },
                "right": {
                  "op": "literal",
                  "value": 60
                }
              },
              {
                "op": "ref",
                "id": "var.member.receives_disability_benefit"
              }
            ]
          }
        }
      },
      "exceptions": [],
      "sources": [
        {
          "source_id": "7cfr-271.2",
          "citation": "7 CFR 271.2",
          "term": "Elderly or disabled member",
          "quote": "Elderly or disabled member means a member of a household who: (1) Is 60 years of age or older;"
        }
      ],
      "interpretation": {
        "status": "needs_review",
        "note": "Source is a nine-branch disjunction. Branch (1) age>=60 is computed; branches (2)-(9) collapse to one input predicate. This is a deliberate simplification and must be reviewed."
      }
    },
    {
      "id": "rule.snap.household_has_elderly_or_disabled_member",
      "kind": "classification",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.has_elderly_or_disabled_member",
          "value": {
            "op": "any_over",
            "entity": "household_member",
            "scope": {
              "op": "ref",
              "id": "var.household"
            },
            "value": {
              "op": "ref",
              "id": "var.member.is_elderly_or_disabled"
            }
          }
        }
      },
      "exceptions": [],
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(d)(6)(ii)",
          "quote": "If the household does not contain an elderly or disabled member, as defined in § 271.2 of this chapter, the shelter deduction cannot exceed the maximum shelter deduction limit established for the area."
        }
      ],
      "interpretation": {
        "status": "needs_review",
        "note": "DERIVED term. The regulation tests whether the household 'contains' such a member; the existential is implied, not stated."
      }
    },
    {
      "id": "rule.snap.gross_monthly_income",
      "kind": "calculation",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.gross_monthly_income",
          "value": {
            "op": "add",
            "args": [
              {
                "op": "sum_over",
                "entity": "household_member",
                "scope": {
                  "op": "ref",
                  "id": "var.household"
                },
                "value": {
                  "op": "ref",
                  "id": "var.member.earned_income"
                }
              },
              {
                "op": "sum_over",
                "entity": "household_member",
                "scope": {
                  "op": "ref",
                  "id": "var.household"
                },
                "value": {
                  "op": "ref",
                  "id": "var.member.unearned_income"
                }
              }
            ]
          }
        }
      },
      "exceptions": [],
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(b)",
          "quote": "Household income shall mean all income from whatever source excluding only items specified in paragraph (c) of this section."
        }
      ],
      "interpretation": {
        "status": "needs_review",
        "note": "Open vocabulary question 1: exclusions under (c) are assumed already applied to the member-level inputs."
      }
    },
    {
      "id": "rule.snap.earned_income_total",
      "kind": "calculation",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.earned_income_total",
          "value": {
            "op": "sum_over",
            "entity": "household_member",
            "scope": {
              "op": "ref",
              "id": "var.household"
            },
            "value": {
              "op": "ref",
              "id": "var.member.earned_income"
            }
          }
        }
      },
      "exceptions": [],
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(b)(1)",
          "quote": "Earned income shall include: (i) All wages and salaries of an employee."
        }
      ],
      "interpretation": {
        "status": "needs_review"
      }
    },
    {
      "id": "rule.snap.gross_income_test",
      "kind": "eligibility",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.meets_gross_income_test",
          "value": {
            "op": "lte",
            "left": {
              "op": "ref",
              "id": "var.household.gross_monthly_income"
            },
            "right": {
              "op": "round",
              "mode": "up",
              "to": "1",
              "arg": {
                "op": "multiply",
                "args": [
                  {
                    "op": "convert_period",
                    "from": "year",
                    "to": "month",
                    "method": "divide",
                    "arg": {
                      "op": "parameter",
                      "id": "param.snap.fpl_annual",
                      "args": {
                        "household_size": {
                          "op": "ref",
                          "id": "var.household.size"
                        },
                        "jurisdiction": {
                          "op": "ref",
                          "id": "var.household.jurisdiction"
                        }
                      }
                    }
                  },
                  {
                    "op": "parameter",
                    "id": "param.snap.gross_income_multiplier",
                    "args": {}
                  }
                ]
              }
            }
          }
        }
      },
      "exceptions": [
        {
          "id": "exception.snap.gross_test_waived_elderly_disabled",
          "when": {
            "op": "ref",
            "id": "var.household.has_elderly_or_disabled_member"
          },
          "effect": "substitute",
          "substitute": {
            "assign": {
              "target": "var.household.meets_gross_income_test",
              "value": {
                "op": "literal",
                "value": true
              }
            }
          },
          "priority": 100,
          "sources": [
            {
              "source_id": "7cfr-273.9",
              "citation": "7 CFR 273.9(a)"
            }
          ]
        }
      ],
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(a)(1)",
          "quote": "The income eligibility standards for the 48 contiguous States and the District of Columbia, Guam and the Virgin Islands shall be 130 percent of the Federal income poverty levels for the 48 contiguous States and the District of Columbia."
        }
      ],
      "interpretation": {
        "status": "needs_review",
        "note": "Substitutive exception. Households with an elderly or disabled member are exempt from the gross income test and screened on net income only."
      }
    },
    {
      "id": "rule.snap.standard_deduction_computed",
      "kind": "calculation",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.standard_deduction",
          "value": {
            "op": "parameter",
            "id": "param.snap.standard_deduction",
            "args": {
              "household_size": {
                "op": "clamp",
                "max": {
                  "op": "literal",
                  "value": 6
                },
                "arg": {
                  "op": "ref",
                  "id": "var.household.size"
                }
              },
              "jurisdiction": {
                "op": "ref",
                "id": "var.household.jurisdiction"
              }
            }
          }
        }
      },
      "exceptions": [],
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(d)(1)(i)",
          "quote": "For household sizes greater than six, the standard deduction shall be equal to the standard deduction for a six-person household."
        }
      ],
      "interpretation": {
        "status": "needs_review",
        "note": "The six-person ceiling is encoded by clamping the lookup index, not the resulting value."
      }
    },
    {
      "id": "rule.snap.standard_deduction_minimum",
      "kind": "calculation",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "overrides": [
        "rule.snap.standard_deduction_computed"
      ],
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.standard_deduction",
          "value": {
            "op": "max",
            "args": [
              {
                "op": "parameter",
                "id": "param.snap.standard_deduction",
                "args": {
                  "household_size": {
                    "op": "clamp",
                    "max": {
                      "op": "literal",
                      "value": 6
                    },
                    "arg": {
                      "op": "ref",
                      "id": "var.household.size"
                    }
                  },
                  "jurisdiction": {
                    "op": "ref",
                    "id": "var.household.jurisdiction"
                  }
                }
              },
              {
                "op": "parameter",
                "id": "param.snap.standard_deduction_minimum",
                "args": {
                  "jurisdiction": {
                    "op": "ref",
                    "id": "var.household.jurisdiction"
                  }
                }
              }
            ]
          }
        }
      },
      "exceptions": [],
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(d)(1)(iii)",
          "quote": "Notwithstanding paragraphs (d)(1)(i) and (d)(1)(ii) of this section, the standard deduction for FY 2009 for each household in the 48 States and the District of Columbia, Alaska, Hawaii, Guam and the U.S. Virgin Islands shall not be less than $144, $246, $203, $289, and $127, respectively."
        }
      ],
      "interpretation": {
        "status": "needs_review",
        "note": "Cross-rule override. 'Notwithstanding' is a norm-precedence statement, which rule-local exception priority cannot express."
      }
    },
    {
      "id": "rule.snap.earned_income_deduction",
      "kind": "calculation",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.earned_income_deduction",
          "value": {
            "op": "multiply",
            "args": [
              {
                "op": "ref",
                "id": "var.household.earned_income_total"
              },
              {
                "op": "parameter",
                "id": "param.snap.earned_income_deduction_rate",
                "args": {}
              }
            ]
          }
        }
      },
      "exceptions": [],
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(d)(2)",
          "quote": "Twenty percent of gross earned income as defined in paragraph (b)(1) of this section."
        }
      ],
      "interpretation": {
        "status": "needs_review"
      }
    },
    {
      "id": "rule.snap.income_after_other_deductions",
      "kind": "calculation",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.income_after_other_deductions",
          "value": {
            "op": "max",
            "args": [
              {
                "op": "literal",
                "value": 0
              },
              {
                "op": "subtract",
                "args": [
                  {
                    "op": "ref",
                    "id": "var.household.gross_monthly_income"
                  },
                  {
                    "op": "ref",
                    "id": "var.household.standard_deduction"
                  },
                  {
                    "op": "ref",
                    "id": "var.household.earned_income_deduction"
                  }
                ]
              }
            ]
          }
        }
      },
      "exceptions": [],
      "sources": [
        {
          "source_id": "7cfr-273.9",
          "citation": "7 CFR 273.9(d)(6)(ii)",
          "quote": "Monthly shelter expenses in excess of 50 percent of the household's income after all other deductions in paragraphs (d)(1) through (d)(5) of this section have been allowed."
        }
      ],
      "interpretation": {
        "status": "needs_review",
        "note": "Deduction ordering is semantic: excess shelter is computed on income already reduced by (d)(1)-(d)(5). v0.1 implements the standard and earned-income deductions only."
      }
    },
    {
      "id": "rule.snap.excess_shelter_deduction",
      "kind": "calculation",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "when": {
        "op": "literal",
        "value": true
      },
      "then": {
        "assign": {
          "target": "var.household.excess_shelter_deduction",
          "value": {
            "op": "max",
            "args": [
              {
                "op": "literal",
                "value": 0
              },
              {
                "op": "subtract",
                "args": [
                  {
                    "op": "ref",
                    "id": "var.household.shelter_expenses"
                  },
                  {
                    "op": "multiply",
                    "args": [
                      {
                        "op": "ref",
                        "id": "var.household.income_after_other_deductions"
                      },
                      {
                        "op": "parameter",
                        "id": "param.snap.shelter_income_share",
                        "args": {}
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "exceptions": [
        {
          "id": "exception.snap.shelter_cap_applies",
          "when": {
            "op": "not",
            "arg": {
              "op": "ref",
              "id": "var.household.has_elderly_or_disabled_member"
            }
          },
          "effect": "substitute",
          "substitute": {
            "assign": {
              "target": "var.household.excess_shelter_deduction",
              "value": {
                "op": "min",
                "args": [
                  {
                    "op": "max",
                    "args": [
                      {
                        "op": "literal",
                        "value": 0
                      },
                      {
                        "op": "subtract",
                        "args": [
                          {
                            "op": "ref",
                            "id": "var.household.shelter_expenses"
                          },
                          {
                            "op": "multiply",
                            "args": [
                              {
                                "op": "ref",
                                "id": "var.household.income_after_other_deductions"
                              },
                              {
                                "op": "parameter",
                                "id": "param.snap.shelter_income_share",
                                "args": {}
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "parameter",
