# ─── Local tooling config — never commit ─────────────────────────────
# Editor and assistant configuration is local to a developer's machine and is
# not part of the project. Keep it out of the published repository.
CLAUDE.md
AGENTS.md
.claude/
.agents/
.venv/

# ─── gstack (machine-generated; never commit) ────────────────────────
# gstack installs globally and is re-generated by `./setup` on each machine.
# Committing these would vendor one machine's copy and shadow the global install.
.gstack/
.claude/skills/
.agents/

# Claude Code local overrides (per-developer, not shared)
.claude/settings.local.json

# ─── Secrets ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── OS / editor noise ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ─── Review application runtime state ────────────────────────────────
# The audit database is runtime state, not source. It also contains real
# reviewer decisions once deployed, which do not belong in a public repository.
*.db
*.db-journal
*.sqlite
*.sqlite3

# ─── Python build output ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ─── Dependencies / build output ─────────────────────────────────────
node_modules/
dist/
build/
.next/
out/
coverage/
*.log
